-- ============================================================
-- 	TOGGLE
-- ============================================================
function SugarUI:CreateToggle(config)
	config = config or {}
	local callback = resolveCallback(config)
	local state = config.Default or false

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = Theme.PanelTransparency,
		LayoutOrder = self._rowCount,
		Parent = self.Page,
	}, { corner(16), stroke(Theme.Stroke, 1), pad(0, 0, 16, 0, 16) })
	trackThemeColor(Row, "BackgroundColor3", "Panel")
	self._rowCount += 1

	new("TextLabel", {
		Text = config.Text or "Opción",
		Font = Theme.Font,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -60, 1, 0),
		Parent = Row,
	})

	local Track = new("Frame", {
		Size = UDim2.new(0, 42, 0, 22),
		Position = UDim2.new(1, -42, 0.5, -11),
		BackgroundColor3 = state and Theme.Accent or Theme.PanelAlt,
		Parent = Row,
	}, { corner(11), stroke(Theme.Stroke, 1) })

	local Knob = new("Frame", {
		Size = UDim2.new(0, 16, 0, 16),
		Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
		BackgroundColor3 = Theme.Text,
		Parent = Track,
	}, { corner(8) })

	local ClickOverlay = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1,0,1,0), Parent = Row })

	local Toggle = setmetatable({ Track = Track, Knob = Knob, Value = state, Callback = callback, _threads = {} }, SugarUI)

	local function paint(newState)
		TweenService:Create(Track, TweenInfo.new(0.15), { BackgroundColor3 = newState and Theme.Accent or Theme.PanelAlt }):Play()
		TweenService:Create(Knob, TweenInfo.new(0.15), { Position = newState and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8) }):Play()
	end

	-- Si este Toggle está ENCENDIDO en este momento, su riel se repinta
	-- con el acento nuevo. Si está apagado, se queda con el gris neutro
	-- (Theme.PanelAlt) — esto es lo que faltaba para que un Auto-M1
	-- prendido no se quedara con el color viejo al cambiar de paleta.
	onAccentChanged(function()
		if Track.Parent then
			TweenService:Create(Track, TweenInfo.new(0.15), {
				BackgroundColor3 = Toggle.Value and Theme.Accent or Theme.PanelAlt,
			}):Play()
		end
	end)

	function Toggle:Set(newState)
		newState = not not newState
		self.Value = newState
		paint(newState)
		SugarUI.FlagValues[config.Flag] = newState
		safeCall(self, self.Callback, newState)
	end

	function Toggle:Stop()
		stopThread(self)
	end

	table.insert(self.Window._connections, ClickOverlay.MouseButton1Click:Connect(function()
		Toggle:Set(not Toggle.Value)
	end))

	registerFlag(config.Flag, Toggle, state)
	return Toggle
end

-- ============================================================
-- 	SLIDER
-- ============================================================
function SugarUI:CreateSlider(config)
	config = config or {}
	local callback = resolveCallback(config)
	local min = config.Min or 0
	local max = config.Max or 100
	local value = math.clamp(config.Default or min, min, max)

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = Theme.PanelTransparency,
		LayoutOrder = self._rowCount,
		Parent = self.Page,
	}, { corner(16), stroke(Theme.Stroke, 1), pad(0, 10, 16, 10, 16) })
	trackThemeColor(Row, "BackgroundColor3", "Panel")
	self._rowCount += 1

	new("TextLabel", {
		Text = config.Text or "Valor",
		Font = Theme.Font,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -50, 0, 18),
		Parent = Row,
	})

	local ValueLabel = new("TextLabel", {
		Text = tostring(value),
		Font = Theme.FontSemibold,
		TextSize = 13,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 50, 0, 18),
		Position = UDim2.new(1, -50, 0, 0),
		Parent = Row,
	})
	trackAccentColor(ValueLabel, "TextColor3")

	local Track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 8),
		Position = UDim2.new(0, 0, 0, 30),
		BackgroundColor3 = Theme.PanelAlt,
		Parent = Row,
	}, { corner(4) })
	trackThemeColor(Track, "BackgroundColor3", "PanelAlt")

	local function ratio(v)
		return (v - min) / math.max(max - min, 1e-6)
	end

	local Fill = new("Frame", {
		Size = UDim2.new(ratio(value), 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		Parent = Track,
	}, { corner(4) })
	trackAccentColor(Fill, "BackgroundColor3")

	local Knob = new("Frame", {
		Size = UDim2.new(0, 14, 0, 14),
		Position = UDim2.new(ratio(value), -7, 0.5, -7),
		BackgroundColor3 = Theme.Text,
		Parent = Track,
	}, { corner(7) })

	local Slider = setmetatable({ Track = Track, Fill = Fill, Knob = Knob, Value = value, Callback = callback, _threads = {} }, SugarUI)

	local function paint(v)
		local r = ratio(v)
		Fill.Size = UDim2.new(r, 0, 1, 0)
		Knob.Position = UDim2.new(r, -7, 0.5, -7)
		ValueLabel.Text = tostring(v)
	end

	function Slider:Set(newValue)
		newValue = math.clamp(math.floor(newValue + 0.5), min, max)
		self.Value = newValue
		paint(newValue)
		SugarUI.FlagValues[config.Flag] = newValue
		safeCall(self, self.Callback, newValue)
	end

	function Slider:Stop()
		stopThread(self)
	end

	local dragging = false
	local function setFromX(xPos)
		local relative = math.clamp((xPos - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
		Slider:Set(min + relative * (max - min))
	end

	local function isMouseOverThisTrack()
		local ok, mousePos = pcall(function()
			return UserInputService:GetMouseLocation()
		end)
		if not ok then return true end
		local tPos, tSize = Track.AbsolutePosition, Track.AbsoluteSize
		return mousePos.Y >= tPos.Y - 20 and mousePos.Y <= tPos.Y + tSize.Y + 20
	end

	table.insert(self.Window._connections, Track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end))

	table.insert(self.Window._connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			if isMouseOverThisTrack() then
				setFromX(input.Position.X)
			end
		end
	end))

	table.insert(self.Window._connections, UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
		end
	end))

	registerFlag(config.Flag, Slider, value)
	return Slider
end

