-- ============================================================
-- 	CREATE TAB
-- ============================================================
function SugarUI:CreateTab(config)
	config = config or {}
	self:_getSection(config.Section or "GENERAL")

	local isFirst = #self._tabs == 0

	local tabChildren = { corner(22) }
	if isFirst then
		table.insert(tabChildren, accentGradient())
	end

	local TabButton = new("TextButton", {
		Name = config.Name,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = isFirst and Theme.Accent or Theme.Sidebar,
		Size = UDim2.new(1, 0, 0, 44),
		Parent = self.SidebarList,
	}, tabChildren)

	local iconCircle = new("TextLabel", {
		Text = config.Icon or "•",
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = Theme.Text,
		BackgroundColor3 = isFirst and Color3.fromRGB(255,255,255) or Theme.PanelAlt,
		BackgroundTransparency = isFirst and 0.85 or 0,
		Size = UDim2.new(0, 26, 0, 26),
		Position = UDim2.new(0, 9, 0.5, -13),
		Parent = TabButton,
	}, { corner(13) })
	if not isFirst then
		trackThemeColor(iconCircle, "BackgroundColor3", "PanelAlt")
	end

	local Indicator = new("Frame", {
		Name = "Indicator",
		Size = UDim2.new(0, 3, 0, 20),
		Position = UDim2.new(0, 2, 0.5, -10),
		BackgroundColor3 = Theme.Text,
		BackgroundTransparency = isFirst and 0.15 or 1,
		Parent = TabButton,
	}, { corner(2) })

	new("TextLabel", {
		Text = config.Name or "Tab",
		Font = Theme.FontSemibold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -55, 1, 0),
		Position = UDim2.new(0, 45, 0, 0),
		Parent = TabButton,
	})

	if not isFirst then
		hoverThemeTint(TabButton, "Sidebar", "PanelAlt")
	end

	local Page = new("Frame", {
		Name = config.Name .. "Page",
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = isFirst,
		LayoutOrder = 1,
		Parent = self.ContentScroll,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 18), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	new("TextLabel", {
		Text = config.Name,
		Font = Theme.FontBold,
		TextSize = 26,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 32),
		LayoutOrder = 0,
		Parent = Page,
	})

	new("TextLabel", {
		Text = config.Description or "",
		Font = Theme.Font,
		TextSize = 14,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 20),
		LayoutOrder = 1,
		Visible = config.Description ~= nil,
		Parent = Page,
	})

	local Tab = setmetatable({
		Window = self,
		Button = TabButton,
		Page = Page,
		Indicator = Indicator,
		_rowCount = 2,
	}, SugarUI)

	-- Repinta el fondo de ESTA pestaña con el acento nuevo SOLO si es la
	-- pestaña activa en este momento (Page.Visible == true). Las pestañas
	-- apagadas siguen con Theme.Sidebar (color neutro) y no se tocan.
	-- Esto es lo que faltaba para que la pestaña activa no se quedara con
	-- el color viejo al cambiar de paleta mientras el panel está abierto.
	onAccentChanged(function()
		if TabButton.Parent and Page.Visible then
			TabButton.BackgroundColor3 = Theme.Accent
		end
	end)

	table.insert(self._connections, TabButton.MouseButton1Click:Connect(function()
		for _, t in ipairs(self._tabs) do
			t.Page.Visible = false
			t.Button.BackgroundColor3 = Theme.Sidebar
			t.Indicator.BackgroundTransparency = 1
		end
		Page.Visible = true
		TabButton.BackgroundColor3 = Theme.Accent
		Indicator.BackgroundTransparency = 0.15
		safeCall(nil, Tab.OnSelect)
	end))

	table.insert(self._tabs, Tab)
	return Tab
end

