-- ============================================================
-- 	COLOR DE ACENTO EN CALIENTE
-- ============================================================
-- 3 paletas de acento para elegir desde el engranaje de la burbuja.
-- Solo cambian Accent/AccentDim: el resto del tema (fondo, texto, etc.)
-- se mantiene igual, así que el cambio es puramente de "color de marca".
local ThemePalettes = {
	Rojo = {
		Accent = Color3.fromRGB(214, 38, 51), AccentDim = Color3.fromRGB(150, 26, 36),
		Background = Color3.fromRGB(46, 12, 16), Sidebar = Color3.fromRGB(42, 11, 15),
