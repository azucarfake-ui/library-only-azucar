	-- actual con tonos rosas fijos. El degradado se guarda en una
	-- variable (LollipopGradient) y se re-registra en accentListeners
	-- para poder reconstruirse con el Accent/AccentDim nuevo cada vez que
	-- se cambia de paleta — antes esto NO pasaba (se armaba una sola vez
	-- con `new("UIGradient", ...)` directo) y por eso la piruleta se
	-- quedaba con el rojo viejo aunque el resto de la UI ya fuera azul.
	local function buildLollipop(parent, size, layoutOrder)
		local box = new("Frame", {
			Size = UDim2.new(0, size, 0, size + 12),
			BackgroundTransparency = 1,
			LayoutOrder = layoutOrder,
			Parent = parent,
		})

		new("Frame", {
			Size = UDim2.new(0, 2, 0, 12),
			Position = UDim2.new(0.5, 4, 0, size - 6),
			Rotation = -16,
			BackgroundColor3 = Color3.fromRGB(232, 222, 208),
			Parent = box,
		}, { corner(1) })

		local function buildLollipopSequence()
			return ColorSequence.new({
				ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 182, 210)),
				ColorSequenceKeypoint.new(0.25, Theme.Accent),
				ColorSequenceKeypoint.new(0.50, Color3.fromRGB(255, 121, 170)),
				ColorSequenceKeypoint.new(0.75, Theme.AccentDim),
				ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 182, 210)),
			})
		end

		local LollipopGradient = new("UIGradient", {
			Color = buildLollipopSequence(),
			Rotation = 35,
		})

		new("Frame", {
			Size = UDim2.new(0, size, 0, size),
			Position = UDim2.new(0, 1, 0, 2),
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BackgroundTransparency = 0.8,
			ZIndex = 0,
			Parent = box,
		}, { corner(size / 2) })

