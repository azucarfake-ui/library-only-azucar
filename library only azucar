--[[
	AzucarHackerUI  v2.1.0
	======================
	Panel estilo exploit: riel angosto de pestañas a la izquierda, cada
	pestaña abre su columna de filas, y las filas de tipo "Grupo" abren
	OTRA columna al lado. Todo oscuro, acento rojo cuando algo está
	activo, tipografía monoespaciada.

	MOTOR IDÉNTICO AL DE SugarUI: mismos Callbacks en hilos independientes
	(task.spawn + pcall, concurrencia ilimitada), mismos Flags/FlagValues,
	misma limpieza de conexiones, mismos alias de campos:
		Text | Name                  → texto de la fila
		Min/Max | Range = {min, max} → rango del slider
		Default | CurrentValue       → valor inicial
		Increment | Step             → salto del slider
		Callback | Logic = TuTabla   → lógica a ejecutar

	NOVEDADES DE ESTA VERSIÓN (v2.1.0):

	1. PANEL UN POCO MÁS ALTO, extendido hacia arriba.
	   Antes el panel arrancaba justo en el borde de la zona segura
	   (debajo de la barra de Roblox), que era lo más alto posible sin
	   tocar esa reserva. Ahora el ScreenGui usa IgnoreGuiInset = true y
	   arranca a solo config.TopOffset (20px por defecto) del borde REAL
	   de la pantalla, así que gana algo de alto extra por arriba. Si en
	   tu juego eso choca visualmente con los íconos de Roblox (chat,
	   mochila, etc.), subí ese número desde CreateWindow({ TopOffset = ... }).

	2. ANIMACIÓN DE APERTURA: entra deslizándose desde la izquierda.
	   Cada vez que se abre el panel (Window:Show() / :Toggle() cuando
	   estaba oculto), la cabecera, el riel y la columna (o columnas, si
	   hay un Grupo abierto) que estén visibles en ese momento arrancan
	   corridos hacia la izquierda (fuera de pantalla) y se deslizan con
	   un tween hasta su posición normal. Cada pieza recuerda su propia
	   posición "de origen" (guardada una sola vez al crearse) para poder
	   volver ahí sin desarmarse.

	3. ROJO CON BRILLO TIPO VIDRIO/REFLEJO.
	   Los elementos que usan el color de acento como una BARRA sólida
	   (la rayita de la cabecera, la marca de la pestaña activa, el
	   cuadradito de los Toggles, y el relleno de los Sliders) ahora
	   llevan encima una capa fina de brillo: un degradado blanco que se
	   desvanece de arriba hacia abajo, dando el efecto de una superficie
	   que refleja luz en vez de un color plano. Esa capa no bloquea
	   clicks (Active = false) y sigue la forma redondeada del elemento
	   debajo.

	POR QUÉ ANTES NO SE VEÍA NADA (arreglado en v2.0.0, se mantiene):

	1. Todo quedaba TAPADO por la barra superior de Roblox — resuelto.
	2. La ventana NO tenía título en ningún lado — resuelto.
	3. Faltaban la MITAD de los componentes — resuelto.
	4. RED DE SEGURIDAD: un Create... inexistente ya no rompe el script.

	Uso básico:

		local UI = loadstring(game:HttpGet("...AzucarHackerUI.lua"))()

		local Window = UI:CreateWindow({ Title = "Azúcar Hub", Subtitle = "v1" })

		local Combate = Window:CreateTab({ Name = "Combate", Icon = "C" })

		Combate:CreateSection("Farmeo")

		Combate:CreateToggle({
			Text = "Auto Farm",
			Flag = "AutoFarm",
			Callback = function(state)
				while state and UI.FlagValues["AutoFarm"] do
					task.wait(0.1)
				end
			end,
		})

		local Avanzado = Combate:CreateGroup({ Name = "Ajustes avanzados" })
		Avanzado:CreateSlider({ Text = "Velocidad", Range = {0, 200}, Default = 16,
			Callback = function(v) print(v) end })

		UI:SetAccentColor("Azul")   -- "Rojo" | "Azul" | "Verde" | "Blanco"
]]

local TweenService     = game:GetService("TweenService")
local Players          = game:GetService("Players")
local UserInputService  = game:GetService("UserInputService")

local UI = {}

UI.Version    = "2.1.0"
UI.Windows    = {}
UI.Flags      = {}
UI.FlagValues = {}

-- ============================================================
-- 	RED DE SEGURIDAD: un Create... inexistente no mata el script
-- ============================================================
local Stub = {}
Stub.__index = function()
	return function()
		return setmetatable({}, Stub)
	end
end

local function classIndex(_, key)
	local found = rawget(UI, key)
	if found ~= nil then
		return found
	end
	if type(key) == "string" and key:sub(1, 6) == "Create" then
		warn("[AzucarHackerUI] El método '" .. key .. "' no existe en esta librería. "
			.. "Se ignoró esa línea para no cortar el resto del script.")
		return function()
			return setmetatable({}, Stub)
		end
	end
	return nil
end

UI.__index = classIndex

-- ============================================================
-- 	DÓNDE COLGAR LA INTERFAZ
-- ============================================================
local function getGuiParent()
	local getHui = rawget(_G, "gethui")
	if typeof(getHui) == "function" then
		local ok, hui = pcall(getHui)
		if ok and hui then
			return hui
		end
	end

	local okCore, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okCore and coreGui then
		local okTest = pcall(function()
			local probe = Instance.new("Folder")
			probe.Parent = coreGui
			probe:Destroy()
		end)
		if okTest then
			return coreGui
		end
	end

	local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
	return player:WaitForChild("PlayerGui")
end

