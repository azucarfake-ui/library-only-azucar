--[[
	AzucarHackerUI
	--------------
	Piel nueva, estética oscura/seria tipo panel de exploit: un riel
	angosto de pestañas a la izquierda de la pantalla; cada pestaña abre
	una columna con sus filas (toggles, sliders, botones, dropdowns); las
	filas de tipo "Grupo" tienen una flechita que despliega OTRA columna
	al lado, con su propio contenido — igual que en la referencia que
	mandaste. Los controles activos se pintan en rojo. Todo se
	abre/cierra con la tecla K, como siempre.

	EL MOTOR ES EL MISMO QUE SugarUI (Azúcar Hub): mismo sistema de
	Callbacks corriendo en hilos independientes (task.spawn + pcall,
	concurrencia ilimitada), mismos Flags/FlagValues, misma limpieza de
	conexiones, y los mismos alias de nombres de campo que ya veníamos
	usando:
		- Text  o  Name          (texto de la fila)
		- Min/Max  o  Range = {min, max}
		- Default  o  CurrentValue
		- Increment  o  Step
		- Callback  o  Logic = TuTabla (con :Toggle/:Enable+Disable/:Set/:Run)

	Esto significa que tu script de lógica (los 4500 líneas) NO necesita
	reescribirse — solo tenés que apuntar el require/loadstring a este
	archivo en vez de a SugarUI. Las llamadas a CreateToggle, CreateSlider,
	CreateButton, CreateDropdown, CreateKeybind funcionan igual.

	Lo nuevo de acá es CreateTab (ahora vive en el riel izquierdo) y
	CreateGroup (la fila con flechita que despliega la columna lateral).

	Uso básico:

		local UI = require(script.AzucarHackerUI)

		local Window = UI:CreateWindow({ Title = "Azúcar Hub" })

		local Combate = Window:CreateTab({ Name = "Combate", Icon = "C" })

		Combate:CreateToggle({
			Text = "Auto Farm",
			Flag = "AutoFarm",
			Callback = function(state) ... end,
		})

		local Ajustes = Combate:CreateGroup({ Name = "Ajustes avanzados" })
		Ajustes:CreateSlider({ Text = "Velocidad", Range = {0, 200}, Default = 16, Callback = function(v) ... end })
]]

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local HackerUI = {}
HackerUI.__index = HackerUI

HackerUI.Version    = "1.0.0"
HackerUI.Windows    = {}
HackerUI.Flags      = {}
HackerUI.FlagValues = {}

local function getGuiParent()
	local ok, coreGui = pcall(function() return game:GetService("CoreGui") end)
	if ok and coreGui then
		local getHui = rawget(_G, "gethui")
		if typeof(getHui) == "function" then
			local success, hui = pcall(getHui)
			if success and hui then return hui end
		end
	end
	local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
	return player:WaitForChild("PlayerGui")
end

-- ============================================================
-- 	TEMA: oscuro/serio, acento rojo cuando algo está activo
-- ============================================================
local Theme = {
	Rail      = Color3.fromRGB(10, 10, 12),
	Panel     = Color3.fromRGB(18, 18, 21),
	PanelAlt  = Color3.fromRGB(26, 26, 30),
	Border    = Color3.fromRGB(42, 42, 47),
	Text      = Color3.fromRGB(232, 232, 235),
	TextDim   = Color3.fromRGB(140, 140, 148),
	Active    = Color3.fromRGB(224, 48, 48),
	ActiveDim = Color3.fromRGB(165, 32, 32),
	Font      = Enum.Font.Code,
	FontBold  = Enum.Font.Code,
}
HackerUI.Theme = Theme

-- ============================================================
-- 	HELPERS
-- ============================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do
		inst[prop] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 4) })
end

local function stroke(color, thickness)
	return new("UIStroke", { Color = color or Theme.Border, Thickness = thickness or 1 })
end

local function pad(all, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop    = UDim.new(0, top or all or 0),
		PaddingRight  = UDim.new(0, right or all or 0),
		PaddingBottom = UDim.new(0, bottom or all or 0),
		PaddingLeft   = UDim.new(0, left or all or 0),
	})
end

local function hoverTint(obj, base, hover)
	obj.MouseEnter:Connect(function()
		TweenService:Create(obj, TweenInfo.new(0.1), { BackgroundColor3 = hover }):Play()
	end)
	obj.MouseLeave:Connect(function()
		TweenService:Create(obj, TweenInfo.new(0.1), { BackgroundColor3 = base }):Play()
	end)
end

-- ============================================================
-- 	NÚCLEO (idéntico en espíritu al de SugarUI): callbacks en hilos
-- 	independientes, concurrencia ilimitada, nunca congela nada.
-- ============================================================
local function safeCall(controller, fn, ...)
	fn = fn or function() end
	if typeof(fn) ~= "function" then return nil end

	local args = table.pack(...)
	if controller then
		controller._threads = controller._threads or {}
	end

	local thread = task.spawn(function()
		local selfThread = coroutine.running()
		if controller then controller._threads[selfThread] = true end

		local ok, err = pcall(function()
			fn(table.unpack(args, 1, args.n))
		end)
		if not ok then
			warn("[AzucarHackerUI] Error en callback conectado por el usuario: " .. tostring(err))
		end

		if controller and controller._threads then
			controller._threads[selfThread] = nil
		end
	end)
	return thread
end

-- Adaptador de lógica: acepta Callback = function(...) igual que antes, o
-- Logic = TuTabla con :Toggle/:Enable+Disable/:Set/:Run, o una función
-- suelta.
local function resolveCallback(config)
	if typeof(config.Callback) == "function" then
		return config.Callback
	end
	local logic = config.Logic
	if logic == nil then return function() end end
	if typeof(logic) == "function" then return logic end
	if typeof(logic) == "table" then
		return function(value)
			if typeof(value) == "boolean" then
				if value and typeof(logic.Enable) == "function" then logic.Enable() return end
				if not value and typeof(logic.Disable) == "function" then logic.Disable() return end
			end
			if typeof(logic.Toggle) == "function" then logic.Toggle(value)
			elseif typeof(logic.Set) == "function" then logic.Set(value)
			elseif typeof(logic.Run) == "function" then logic.Run(value)
			else
				warn("[AzucarHackerUI] Logic conectada no tiene :Toggle/:Enable+Disable/:Set/:Run.")
			end
		end
	end
	return function() end
end

local function registerFlag(flagName, controller, initialValue)
	if not flagName then return end
	HackerUI.Flags[flagName] = controller
	HackerUI.FlagValues[flagName] = initialValue
end

local function stopAllThreads(controller)
	if not controller._threads then return end
	for th in pairs(controller._threads) do
		pcall(task.cancel, th)
	end
	controller._threads = {}
end

-- ============================================================
-- 	CREATE WINDOW — riel angosto a la izquierda
-- ============================================================
function HackerUI:CreateWindow(config)
	config = config or {}

	local ScreenGui = new("ScreenGui", {
		Name = config.Title or "AzucarHackerUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
		IgnoreGuiInset = true,
	})
	local protectGui = rawget(_G, "protectgui") or rawget(_G, "protect_gui")
	if typeof(protectGui) == "function" then pcall(protectGui, ScreenGui) end
	ScreenGui.Parent = getGuiParent()

	local RAIL_W = config.RailWidth or 48
	local PANEL_W = config.PanelWidth or 220

	local Root = new("Frame", {
		Name = "Root",
		Size = UDim2.new(0, RAIL_W, 1, 0),
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
	})

	local Rail = new("Frame", {
		Name = "Rail",
		Size = UDim2.new(0, RAIL_W, 1, 0),
		BackgroundColor3 = Theme.Rail,
		Parent = Root,
	}, { stroke(Theme.Border, 1) })

	local RailList = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Rail,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(6, 6, 4, 6, 4),
	})

	local Window = setmetatable({
		ScreenGui = ScreenGui,
		Root = Root,
		Rail = Rail,
		RailList = RailList,
		RAIL_W = RAIL_W,
		PANEL_W = PANEL_W,
		_tabs = {},
		_connections = {},
		_visible = true,
	}, HackerUI)

	local function track(conn)
		table.insert(Window._connections, conn)
		return conn
	end

	-- ---------------- Tecla K: abre/cierra todo ----------------
	local toggleKey = config.ToggleKey or Enum.KeyCode.K
	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == toggleKey then
			Window:Toggle()
		end
	end))

	table.insert(HackerUI.Windows, Window)
	return Window
end

function HackerUI:Show()
	self.Root.Visible = true
	self._visible = true
end

function HackerUI:Hide()
	self.Root.Visible = false
	self._visible = false
end

function HackerUI:Toggle()
	if self._visible then self:Hide() else self:Show() end
end

function HackerUI:Destroy()
	if self._connections then
		for _, c in ipairs(self._connections) do
			pcall(function() c:Disconnect() end)
		end
	end
	if self.ScreenGui then self.ScreenGui:Destroy() end
	for i, w in ipairs(HackerUI.Windows) do
		if w == self then table.remove(HackerUI.Windows, i) break end
	end
end

-- ============================================================
-- 	CREATE TAB — botón en el riel + columna que aparece al lado
-- ============================================================
function HackerUI:CreateTab(config)
	config = config or {}
	local name = config.Text or config.Name or "Tab"
	local isFirst = #self._tabs == 0

	local TabBtn = new("TextButton", {
		Text = config.Icon or string.sub(name, 1, 1),
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = isFirst and Theme.Active or Theme.TextDim,
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Panel,
		Size = UDim2.new(1, 0, 0, 34),
		Parent = self.RailList,
	}, { corner(4), stroke(Theme.Border, 1) })
	hoverTint(TabBtn, Theme.Panel, Theme.PanelAlt)

	local Panel = new("Frame", {
		Name = name .. "Panel",
		Size = UDim2.new(0, self.PANEL_W, 1, 0),
		Position = UDim2.new(0, self.RAIL_W, 0, 0),
		BackgroundColor3 = Theme.Panel,
		Visible = isFirst,
		Parent = self.Root,
	}, { stroke(Theme.Border, 1) })

	new("TextLabel", {
		Text = name,
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		BackgroundColor3 = Theme.PanelAlt,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, 0, 0, 30),
		Parent = Panel,
	}, { pad(0, 0, 0, 0, 10) })

	local List = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -30),
		Position = UDim2.new(0, 0, 0, 30),
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Panel,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local Tab = setmetatable({
		Window = self,
		Button = TabBtn,
		Panel = Panel,
		List = List,
		_rowCount = 0,
		_groupPanels = {},
	}, HackerUI)

	table.insert(self._connections, TabBtn.MouseButton1Click:Connect(function()
		for _, t in ipairs(self._tabs) do
			t.Panel.Visible = false
			t.Button.TextColor3 = Theme.TextDim
			for _, gp in pairs(t._groupPanels) do
				gp.Instance.Visible = false
				gp.Arrow.Text = "▸"
			end
		end
		Panel.Visible = true
		TabBtn.TextColor3 = Theme.Active
	end))

	table.insert(self._tabs, Tab)
	return Tab
end

-- ============================================================
-- 	CREATE GROUP — la fila con flechita que despliega la columna
-- 	lateral (como en la referencia: adentro va la lógica de ese grupo).
-- ============================================================
function HackerUI:CreateGroup(config)
	config = config or {}
	local name = config.Text or config.Name or "Grupo"
	local window = self.Window or self

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = Theme.Panel,
		LayoutOrder = self._rowCount,
		Parent = self.List,
	}, { pad(0, 0, 10, 0, 10) })
	hoverTint(Row, Theme.Panel, Theme.PanelAlt)
	self._rowCount += 1

	new("TextLabel", {
		Text = name,
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -22, 1, 0),
		Parent = Row,
	})

	local Arrow = new("TextLabel", {
		Text = "▸",
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = Theme.TextDim,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 20, 1, 0),
		Position = UDim2.new(1, -20, 0, 0),
		Parent = Row,
	})

	-- Panel lateral: aparece a la derecha del panel de este Tab.
	local GroupPanel = new("Frame", {
		Name = name .. "GroupPanel",
		Size = UDim2.new(0, window.PANEL_W, 1, 0),
		Position = UDim2.new(0, window.RAIL_W + window.PANEL_W, 0, 0),
		BackgroundColor3 = Theme.Panel,
		Visible = false,
		Parent = window.Root,
	}, { stroke(Theme.Border, 1) })

	new("TextLabel", {
		Text = name,
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Active,
		BackgroundColor3 = Theme.PanelAlt,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Size = UDim2.new(1, 0, 0, 30),
		Parent = GroupPanel,
	}, { pad(0, 0, 0, 0, 10) })

	local GroupList = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -30),
		Position = UDim2.new(0, 0, 0, 30),
		BackgroundTransparency = 1,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = GroupPanel,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	self._groupPanels[name] = { Instance = GroupPanel, Arrow = Arrow }

	local ClickOverlay = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Row })
	table.insert(window._connections, ClickOverlay.MouseButton1Click:Connect(function()
		-- cerrar los demás grupos de este mismo tab antes de abrir este
		for gname, gp in pairs(self._groupPanels) do
			if gp.Instance ~= GroupPanel then
				gp.Instance.Visible = false
				gp.Arrow.Text = "▸"
			end
		end
		GroupPanel.Visible = not GroupPanel.Visible
		Arrow.Text = GroupPanel.Visible and "◂" or "▸"
	end))

	local Group = setmetatable({
		Window = window,
		Panel = GroupPanel,
		List = GroupList,
		_rowCount = 0,
		_groupPanels = {},
	}, HackerUI)

	return Group
end

-- ============================================================
-- 	TOGGLE — el cuadradito se pinta ROJO cuando está activo
-- ============================================================
function HackerUI:CreateToggle(config)
	config = config or {}
	local callback = resolveCallback(config)
	local state = config.Default
	if state == nil then state = config.CurrentValue end
	if state == nil then state = false end

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = Theme.Panel,
		LayoutOrder = self._rowCount,
		Parent = self.List,
	}, { pad(0, 0, 10, 0, 10) })
	hoverTint(Row, Theme.Panel, Theme.PanelAlt)
	self._rowCount += 1

	new("TextLabel", {
		Text = config.Text or config.Name or "Toggle",
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -26, 1, 0),
		Parent = Row,
	})

	local Box = new("Frame", {
		Size = UDim2.new(0, 14, 0, 14),
		Position = UDim2.new(1, -14, 0.5, -7),
		BackgroundColor3 = state and Theme.Active or Theme.PanelAlt,
		Parent = Row,
	}, { corner(3), stroke(Theme.Border, 1) })

	local ClickOverlay = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Row })

	local Toggle = setmetatable({ Box = Box, Value = state, Callback = callback, _threads = {} }, HackerUI)

	function Toggle:Set(newState)
		newState = not not newState
		self.Value = newState
		TweenService:Create(Box, TweenInfo.new(0.1), { BackgroundColor3 = newState and Theme.Active or Theme.PanelAlt }):Play()
		HackerUI.FlagValues[config.Flag] = newState
		safeCall(self, self.Callback, newState)
	end

	function Toggle:Stop()
		stopAllThreads(self)
	end

	table.insert(self.Window._connections, ClickOverlay.MouseButton1Click:Connect(function()
		Toggle:Set(not Toggle.Value)
	end))

	registerFlag(config.Flag, Toggle, state)
	return Toggle
end

-- ============================================================
-- 	SLIDER — acepta Min/Max o Range={min,max}, Default o CurrentValue,
-- 	Increment o Step
-- ============================================================
function HackerUI:CreateSlider(config)
	config = config or {}
	local callback = resolveCallback(config)

	local rangeMin, rangeMax = config.Min, config.Max
	if typeof(config.Range) == "table" then
		rangeMin = rangeMin or config.Range[1]
		rangeMax = rangeMax or config.Range[2]
	end
	local min = rangeMin or 0
	local max = rangeMax or 100
	local step = config.Increment or config.Step or 1
	if step <= 0 then step = 1 end

	local function snap(v)
		v = math.clamp(v, min, max)
		return min + math.floor((v - min) / step + 0.5) * step
	end

	local value = snap(config.Default or config.CurrentValue or min)

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 42),
		BackgroundColor3 = Theme.Panel,
		LayoutOrder = self._rowCount,
		Parent = self.List,
	}, { pad(0, 6, 10, 6, 10) })
	self._rowCount += 1

	new("TextLabel", {
		Text = config.Text or config.Name or "Valor",
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -40, 0, 16),
		Parent = Row,
	})

	local ValueLabel = new("TextLabel", {
		Text = tostring(value),
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Right,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 40, 0, 16),
		Position = UDim2.new(1, -40, 0, 0),
		Parent = Row,
	})

	local Track = new("Frame", {
		Size = UDim2.new(1, 0, 0, 4),
		Position = UDim2.new(0, 0, 0, 24),
		BackgroundColor3 = Theme.PanelAlt,
		Parent = Row,
	})

	local function ratio(v) return (v - min) / math.max(max - min, 1e-6) end

	local Fill = new("Frame", {
		Size = UDim2.new(ratio(value), 0, 1, 0),
		BackgroundColor3 = Theme.Active,
		Parent = Track,
	})

	local Knob = new("Frame", {
		Size = UDim2.new(0, 10, 0, 10),
		Position = UDim2.new(ratio(value), -5, 0.5, -5),
		BackgroundColor3 = Theme.Text,
		Parent = Track,
	}, { corner(5) })

	local Slider = setmetatable({ Track = Track, Fill = Fill, Knob = Knob, Value = value, Callback = callback, _threads = {} }, HackerUI)

	local function paint(v)
		local r = ratio(v)
		Fill.Size = UDim2.new(r, 0, 1, 0)
		Knob.Position = UDim2.new(r, -5, 0.5, -5)
		ValueLabel.Text = tostring(v)
	end

	function Slider:Set(newValue)
		newValue = snap(newValue)
		self.Value = newValue
		paint(newValue)
		HackerUI.FlagValues[config.Flag] = newValue
		safeCall(self, self.Callback, newValue)
	end

	function Slider:Stop()
		stopAllThreads(self)
	end

	local dragging = false
	local function setFromX(xPos)
		local relative = math.clamp((xPos - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
		Slider:Set(min + relative * (max - min))
	end
	local function isMouseOverThisTrack()
		local ok, mousePos = pcall(function() return UserInputService:GetMouseLocation() end)
		if not ok then return true end
		local tPos, tSize = Track.AbsolutePosition, Track.AbsoluteSize
		return mousePos.Y >= tPos.Y - 20 and mousePos.Y <= tPos.Y + tSize.Y + 20
	end

	table.insert(self.Window._connections, Track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end))
	table.insert(self.Window._connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			if isMouseOverThisTrack() then setFromX(input.Position.X) end
		end
	end))
	table.insert(self.Window._connections, UserInputService.InputEnded:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			dragging = false
		end
	end))

	registerFlag(config.Flag, Slider, value)
	return Slider
end

-- ============================================================
-- 	BOTÓN — ancho automático, texto blanco fijo
-- ============================================================
function HackerUI:CreateButton(config)
	config = config or {}
	local callback = resolveCallback(config)

	local Btn = new("TextButton", {
		Text = config.Text or config.Name or "Botón",
		Font = Theme.FontBold,
		TextSize = 13,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		AutoButtonColor = false,
		BackgroundColor3 = Theme.PanelAlt,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = self._rowCount,
		Parent = self.List,
	}, { stroke(Theme.Border, 1) })
	self._rowCount += 1

	hoverTint(Btn, Theme.PanelAlt, Theme.Active)

	local Button = setmetatable({ Instance = Btn, Callback = callback, _threads = {} }, HackerUI)

	function Button:Set(...)
		safeCall(self, self.Callback, ...)
	end
	function Button:Stop()
		stopAllThreads(self)
	end

	table.insert(self.Window._connections, Btn.MouseButton1Click:Connect(function()
		Button:Set()
	end))

	registerFlag(config.Flag, Button, nil)
	return Button
end

-- ============================================================
-- 	DROPDOWN — con detección de Player/tabla-con-.Name, y Default
-- 	inválido se ignora en vez de mostrar basura
-- ============================================================
function HackerUI:CreateDropdown(config)
	config = config or {}
	local callback = resolveCallback(config)
	local options = config.Options or {}

	local function displayOption(value)
		if typeof(value) == "Instance" and value.Name then return value.Name end
		if typeof(value) == "table" and value.Name then return tostring(value.Name) end
		return tostring(value)
	end

	local function isValidOption(value)
		for _, opt in ipairs(options) do
			if opt == value then return true end
		end
		return false
	end

	local selected = options[1]
	if config.Default ~= nil and isValidOption(config.Default) then
		selected = config.Default
	end

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = Theme.Panel,
		ClipsDescendants = false,
		ZIndex = 2,
		LayoutOrder = self._rowCount,
		Parent = self.List,
	}, { pad(0, 0, 10, 0, 10) })
	self._rowCount += 1

	new("TextLabel", {
		Text = config.Text or config.Name or "Opciones",
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(0.45, 0, 1, 0),
		Parent = Row,
	})

	local SelectedLabel = new("TextLabel", {
		Text = selected ~= nil and displayOption(selected) or "—",
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0.45, 10, 0, 0),
		Size = UDim2.new(0.55, -10, 1, 0),
		Parent = Row,
	})

	local ClickOverlay = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Row })

	local ListFrame = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, math.min(#options, 5) * 26 + 8),
		Position = UDim2.new(0, 0, 1, 2),
		BackgroundColor3 = Theme.PanelAlt,
		Visible = false,
		ZIndex = 5,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Active,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Row,
	}, {
		stroke(Theme.Border, 1), pad(4),
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local Dropdown = setmetatable({ Value = selected, Callback = callback, Options = options, _threads = {} }, HackerUI)

	function Dropdown:Set(option)
		self.Value = option
		SelectedLabel.Text = displayOption(option)
		HackerUI.FlagValues[config.Flag] = option
		safeCall(self, self.Callback, option)
	end
	function Dropdown:Stop()
		stopAllThreads(self)
	end

	for _, optionValue in ipairs(options) do
		local OptionBtn = new("TextButton", {
			Text = displayOption(optionValue),
			Font = Theme.Font,
			TextSize = 12,
			TextColor3 = Theme.Text,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ClipsDescendants = true,
			BackgroundColor3 = Theme.Panel,
			AutoButtonColor = false,
			Size = UDim2.new(1, 0, 0, 24),
			Parent = ListFrame,
		}, { pad(0, 0, 6, 0, 6) })
		hoverTint(OptionBtn, Theme.Panel, Theme.PanelAlt)

		table.insert(self.Window._connections, OptionBtn.MouseButton1Click:Connect(function()
			Dropdown:Set(optionValue)
			ListFrame.Visible = false
		end))
	end

	table.insert(self.Window._connections, ClickOverlay.MouseButton1Click:Connect(function()
		ListFrame.Visible = not ListFrame.Visible
	end))

	registerFlag(config.Flag, Dropdown, selected)
	return Dropdown
end

-- ============================================================
-- 	KEYBIND
-- ============================================================
function HackerUI:CreateKeybind(config)
	config = config or {}
	local callback = resolveCallback(config)
	local currentKey = config.Default or config.CurrentValue or Enum.KeyCode.RightShift
	local listening = false

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = Theme.Panel,
		LayoutOrder = self._rowCount,
		Parent = self.List,
	}, { pad(0, 0, 10, 0, 10) })
	self._rowCount += 1

	new("TextLabel", {
		Text = config.Text or config.Name or "Tecla",
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -70, 1, 0),
		Parent = Row,
	})

	local KeyButton = new("TextButton", {
		Text = currentKey.Name,
		Font = Theme.FontBold,
		TextSize = 11,
		TextColor3 = Theme.Text,
		AutoButtonColor = false,
		BackgroundColor3 = Theme.PanelAlt,
		Size = UDim2.new(0, 60, 0, 20),
		Position = UDim2.new(1, -60, 0.5, -10),
		Parent = Row,
	}, { stroke(Theme.Border, 1) })

	local Keybind = setmetatable({ Value = currentKey, Callback = callback, _threads = {} }, HackerUI)

	function Keybind:Set(keyCode)
		self.Value = keyCode
		KeyButton.Text = keyCode.Name
		HackerUI.FlagValues[config.Flag] = keyCode
	end
	function Keybind:Stop()
		stopAllThreads(self)
	end

	table.insert(self.Window._connections, KeyButton.MouseButton1Click:Connect(function()
		listening = true
		KeyButton.Text = "..."
	end))

	table.insert(self.Window._connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if listening and input.UserInputType == Enum.UserInputType.Keyboard then
			listening = false
			Keybind:Set(input.KeyCode)
			return
		end
		if not listening and not gameProcessed and input.KeyCode == Keybind.Value then
			safeCall(Keybind, Keybind.Callback, Keybind.Value)
		end
	end))

	registerFlag(config.Flag, Keybind, currentKey)
	return Keybind
end

return HackerUI
