		Stroke = Color3.fromRGB(90, 30, 35),
	},
	Azul = {
		Accent = Color3.fromRGB(45, 130, 230), AccentDim = Color3.fromRGB(28, 88, 168),
		Background = Color3.fromRGB(13, 19, 38), Sidebar = Color3.fromRGB(12, 17, 34),
		Panel = Color3.fromRGB(17, 25, 46), PanelAlt = Color3.fromRGB(23, 34, 58),
		Stroke = Color3.fromRGB(32, 48, 82),
	},
	Negro = {
		Accent = Color3.fromRGB(80, 80, 86), AccentDim = Color3.fromRGB(40, 40, 44),
		Background = Color3.fromRGB(20, 20, 22), Sidebar = Color3.fromRGB(18, 18, 20),
