-- ============================================================
function UI:CreateInput(config)
	config = config or {}
	local callback = resolveCallback(config)

	local Row, window = baseRow(self, 30)
	if not Row then return setmetatable({}, Stub) end

	new("TextLabel", {
		Text = config.Text or config.Name or "Texto",
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Size = UDim2.new(0.42, 0, 1, 0),
		Parent = Row,
	})

	local Box = new("TextBox", {
		Text = tostring(config.Default or config.CurrentValue or ""),
		PlaceholderText = config.PlaceholderText or config.Placeholder or "...",
		Font = Theme.Font,
		TextSize = 11,
		TextColor3 = Theme.Text,
		PlaceholderColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ClearTextOnFocus = false,
		ClipsDescendants = true,
		BackgroundColor3 = Theme.PanelAlt,
		BorderSizePixel = 0,
		Position = UDim2.new(0.44, 0, 0.5, -10),
		Size = UDim2.new(0.56, 0, 0, 20),
		Parent = Row,
	}, { corner(3), stroke(Theme.Border, 1), pad(0, 0, 6, 0, 6) })

	local Input = setmetatable({ Instance = Box, Value = Box.Text, Callback = callback, _threads = {} }, UI)

	function Input:Set(text)
		self.Value = tostring(text)
		Box.Text = self.Value
		setFlagValue(config.Flag, self.Value)
		return safeCall(self, self.Callback, self.Value)
	end

	function Input:Get()
		return Box.Text
	end

	function Input:Stop()
		stopAllThreads(self)
	end

	table.insert(window._connections, Box.FocusLost:Connect(function(enterPressed)
		if enterPressed or config.FireOnLoseFocus then
			Input.Value = Box.Text
			setFlagValue(config.Flag, Box.Text)
			safeCall(Input, Input.Callback, Box.Text)
		end
	end))

	registerFlag(config.Flag, Input, Box.Text)
	return Input
end

-- ============================================================
-- 	KEYBIND
-- ============================================================
function UI:CreateKeybind(config)
	config = config or {}
	local callback = resolveCallback(config)

	local currentKey = config.Default or config.CurrentKeybind or Enum.KeyCode.RightShift
	if typeof(currentKey) == "string" then
		local ok, parsed = pcall(function()
			return Enum.KeyCode[currentKey]
		end)
		currentKey = (ok and parsed) or Enum.KeyCode.RightShift
	end

	local listening = false

	local Row, window = baseRow(self, 30)
	if not Row then return setmetatable({}, Stub) end

	rowLabel(Row, config.Text or config.Name or "Tecla", 66)

	local KeyButton = new("TextButton", {
		Text = currentKey.Name,
		Font = Theme.FontBold,
		TextSize = 11,
		TextColor3 = Theme.Text,
		TextTruncate = Enum.TextTruncate.AtEnd,
		AutoButtonColor = false,
		BackgroundColor3 = Theme.PanelAlt,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 60, 0, 20),
		Position = UDim2.new(1, -60, 0.5, -10),
		Parent = Row,
	}, { corner(3), stroke(Theme.Border, 1) })

	local Keybind = setmetatable({ Value = currentKey, Callback = callback, _threads = {} }, UI)

	function Keybind:Set(keyCode)
		if typeof(keyCode) == "string" then
			local ok, parsed = pcall(function() return Enum.KeyCode[keyCode] end)
			keyCode = (ok and parsed) or self.Value
		end
		self.Value = keyCode
		KeyButton.Text = keyCode.Name
		setFlagValue(config.Flag, keyCode)
	end

	function Keybind:Get()
		return self.Value
	end

	function Keybind:Stop()
		stopAllThreads(self)
	end

	table.insert(window._connections, KeyButton.MouseButton1Click:Connect(function()
		listening = true
		KeyButton.Text = "..."
		KeyButton.TextColor3 = Theme.Active
	end))

	table.insert(window._connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if listening and input.UserInputType == Enum.UserInputType.Keyboard then
			listening = false
			KeyButton.TextColor3 = Theme.Text
			Keybind:Set(input.KeyCode)
			return
		end
		if not listening and not gameProcessed and input.KeyCode == Keybind.Value then
			safeCall(Keybind, Keybind.Callback, Keybind.Value)
		end
	end))

	registerFlag(config.Flag, Keybind, currentKey)
	return Keybind
end

-- ============================================================
-- 	ESTADÍSTICA (número grande + etiqueta)
-- ============================================================
function UI:CreateStat(config)
	config = config or {}
	local list, _, owner = host(self)
	if not list then return setmetatable({}, Stub) end

	local holder = new("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = Theme.Row,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(owner),
		Parent = list,
	}, { pad(0, 5, 10, 5, 10) })

	local ValueLabel = new("TextLabel", {
		Text = tostring(config.Value or "0"),
		Font = Theme.FontBold,
		TextSize = 20,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 21),
		Parent = holder,
	})
	onAccent(function()
		if ValueLabel.Parent then
			ValueLabel.TextColor3 = Theme.Active
		end
	end)

	new("TextLabel", {
		Text = config.Label or config.Text or config.Name or "",
		Font = Theme.Font,
		TextSize = 11,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 0, 21),
		Size = UDim2.new(1, 0, 0, 13),
		Parent = holder,
	})

	local Stat = setmetatable({ Instance = ValueLabel, Value = config.Value or "0" }, UI)

	function Stat:Set(newValue)
		self.Value = newValue
		ValueLabel.Text = tostring(newValue)
	end

	registerFlag(config.Flag, Stat, config.Value)
	return Stat
end

-- Compatibilidad con SugarUI: allá las estadísticas iban dentro de una
-- fila horizontal. Acá van una debajo de otra (la columna es angosta),
-- así que CreateStatRow simplemente devuelve el mismo contenedor.
function UI:CreateStatRow()
	return self
end

return UI
