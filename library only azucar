			Size = UDim2.new(0, size, 0, size),
			BackgroundColor3 = Color3.fromRGB(255, 133, 178),
			ClipsDescendants = true,
			Parent = box,
		}, {
			corner(size / 2),
			stroke(Theme.Stroke, 1),
			LollipopGradient,
		})

		onAccentChanged(function()
			if LollipopGradient and LollipopGradient.Parent then
				LollipopGradient.Color = buildLollipopSequence()
			end
		end)

		new("Frame", {
			Size = UDim2.new(0, size * 0.28, 0, size * 0.16),
			Position = UDim2.new(0, size * 0.16, 0, size * 0.12),
			Rotation = -20,
