--[[
	AzucarHackerUI  v2.0.0
	======================
	Panel estilo exploit: riel angosto de pestañas a la izquierda, cada
	pestaña abre su columna de filas, y las filas de tipo "Grupo" abren
	OTRA columna al lado. Todo oscuro, acento rojo cuando algo está
	activo, tipografía monoespaciada.

	MOTOR IDÉNTICO AL DE SugarUI: mismos Callbacks en hilos independientes
	(task.spawn + pcall, concurrencia ilimitada), mismos Flags/FlagValues,
	misma limpieza de conexiones, mismos alias de campos:
		Text | Name                  → texto de la fila
		Min/Max | Range = {min, max} → rango del slider
		Default | CurrentValue       → valor inicial
		Increment | Step             → salto del slider
		Callback | Logic = TuTabla   → lógica a ejecutar

	POR QUÉ ANTES NO SE VEÍA NADA (arreglado acá):

	1. Todo quedaba TAPADO por la barra superior de Roblox.
	   El ScreenGui usaba IgnoreGuiInset = true y el panel arrancaba en
	   y = 0, así que el título de la pestaña y los primeros botones del
	   riel quedaban debajo de la barra de Roblox (chat, menú, etc.).
	   Ahora hay un margen superior real y el inset se respeta.

	2. La ventana NO tenía título en ningún lado.
	   No existía ningún elemento que mostrara config.Title — por eso
	   "ni el mismo nombre" aparecía. Ahora hay una cabecera propia.

	3. Faltaban la MITAD de los componentes.
	   No existían CreateSection, CreateLabel, CreateParagraph,
	   CreateInput, CreateDivider, CreateStat, CreateProfile, Notify...
	   Si tu script de lógica llamaba a cualquiera de esos, Lua cortaba
	   la ejecución ahí mismo con "attempt to call a nil value" y la UI
	   se quedaba vacía para siempre — exactamente el síntoma que viste:
	   un panel abierto, sin toggles, sin sliders, sin nada.

	4. RED DE SEGURIDAD nueva: si aun así llamás a un método Create...
	   que no existe, la librería ya NO rompe el script. Avisa por
	   consola con warn() y devuelve un objeto inofensivo, así el resto
	   de tus 4500 líneas se sigue construyendo igual.

	Uso básico:

		local UI = loadstring(game:HttpGet("...AzucarHackerUI.lua"))()

		local Window = UI:CreateWindow({ Title = "Azúcar Hub", Subtitle = "v1" })

		local Combate = Window:CreateTab({ Name = "Combate", Icon = "C" })

		Combate:CreateSection("Farmeo")

		Combate:CreateToggle({
			Text = "Auto Farm",
			Flag = "AutoFarm",
			Callback = function(state)
				while state and UI.FlagValues["AutoFarm"] do
					task.wait(0.1)
				end
			end,
		})

		local Avanzado = Combate:CreateGroup({ Name = "Ajustes avanzados" })
		Avanzado:CreateSlider({ Text = "Velocidad", Range = {0, 200}, Default = 16,
			Callback = function(v) print(v) end })

		UI:SetAccentColor("Azul")   -- "Rojo" | "Azul" | "Verde" | "Blanco"
]]

local TweenService     = game:GetService("TweenService")
local Players          = game:GetService("Players")
local UserInputService  = game:GetService("UserInputService")

local UI = {}

UI.Version    = "2.0.0"
UI.Windows    = {}
UI.Flags      = {}
UI.FlagValues = {}

-- ============================================================
-- 	RED DE SEGURIDAD: un Create... inexistente no mata el script
-- ============================================================
-- Objeto tonto: responde a CUALQUIER método devolviendo otro objeto
-- tonto. Sirve para que una cadena como
--    Tab:CreateLoQueSea({...}):Set(true)
-- no explote aunque "CreateLoQueSea" no exista en esta librería.
local Stub = {}
Stub.__index = function()
	return function()
		return setmetatable({}, Stub)
	end
end

local function classIndex(_, key)
	local found = rawget(UI, key)
	if found ~= nil then
		return found
	end
	if type(key) == "string" and key:sub(1, 6) == "Create" then
		warn("[AzucarHackerUI] El método '" .. key .. "' no existe en esta librería. "
			.. "Se ignoró esa línea para no cortar el resto del script.")
		return function()
			return setmetatable({}, Stub)
		end
	end
	return nil
end

UI.__index = classIndex

-- ============================================================
-- 	DÓNDE COLGAR LA INTERFAZ
-- ============================================================
local function getGuiParent()
	local getHui = rawget(_G, "gethui")
	if typeof(getHui) == "function" then
		local ok, hui = pcall(getHui)
		if ok and hui then
			return hui
		end
	end

	local okCore, coreGui = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okCore and coreGui then
		local okTest = pcall(function()
			local probe = Instance.new("Folder")
			probe.Parent = coreGui
			probe:Destroy()
		end)
		if okTest then
			return coreGui
		end
	end

	local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
	return player:WaitForChild("PlayerGui")
end

