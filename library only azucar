			Parent = parent,
		})
		local thickness = 2
		local armLen = math.floor(size * 0.42)
		local specs = {
			{ armLen, thickness, 0, 0 },                             { thickness, armLen, 0, 0 },
			{ armLen, thickness, size - armLen, 0 },                 { thickness, armLen, size - thickness, 0 },
			{ armLen, thickness, 0, size - thickness },              { thickness, armLen, 0, size - armLen },
			{ armLen, thickness, size - armLen, size - thickness },  { thickness, armLen, size - thickness, size - armLen },
		}
		for _, s in ipairs(specs) do
			new("Frame", {
				Size = UDim2.new(0, s[1], 0, s[2]),
				Position = UDim2.new(0, s[3], 0, s[4]),
				BackgroundColor3 = color,
				BorderSizePixel = 0,
