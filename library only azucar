function SugarUI:CreateDropdown(config)
	config = config or {}
	local callback = resolveCallback(config)
	local options = config.Options or {}
	local selected = config.Default or options[1]

	local Row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = Theme.Panel,
		BackgroundTransparency = Theme.PanelTransparency,
		LayoutOrder = self._rowCount,
		ClipsDescendants = false,
		ZIndex = 2,
		Parent = self.Page,
	}, { corner(16), stroke(Theme.Stroke, 1), pad(0, 0, 16, 0, 16) })
	trackThemeColor(Row, "BackgroundColor3", "Panel")
	self._rowCount += 1

	new("TextLabel", {
		Text = config.Text or "Opciones",
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(0.5, 0, 1, 0),
		Parent = Row,
	})

	local SelectedLabel = new("TextLabel", {
		Text = tostring(selected or "—"),
		Font = Theme.FontSemibold,
		TextSize = 14,
		TextColor3 = Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0.5, 20, 0, 0),
		Size = UDim2.new(0.5, -20, 1, 0),
		Parent = Row,
	})
	trackAccentColor(SelectedLabel, "TextColor3")

	local ClickOverlay = new("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Row })

	local ListFrame = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, math.min(#options, 5) * 32 + 8),
		Position = UDim2.new(0, 0, 1, 6),
		BackgroundColor3 = Theme.PanelAlt,
		Visible = false,
		ZIndex = 5,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = Theme.Accent,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Row,
	}, {
		corner(12), stroke(Theme.Stroke, 1), pad(4),
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	trackAccentColor(ListFrame, "ScrollBarImageColor3")
	trackThemeColor(ListFrame, "BackgroundColor3", "PanelAlt")

	local Dropdown = setmetatable({ Value = selected, Callback = callback, Options = options, _threads = {} }, SugarUI)

	function Dropdown:Set(option)
		self.Value = option
		SelectedLabel.Text = tostring(option)
		SugarUI.FlagValues[config.Flag] = option
		safeCall(self, self.Callback, option)
	end

	function Dropdown:Stop()
		stopThread(self)
	end

	for _, optionValue in ipairs(options) do
		local OptionBtn = new("TextButton", {
			Text = tostring(optionValue),
			Font = Theme.Font,
			TextSize = 13,
			TextColor3 = Theme.Text,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ClipsDescendants = true,
			BackgroundColor3 = Theme.Panel,
			AutoButtonColor = false,
			Size = UDim2.new(1, 0, 0, 28),
			Parent = ListFrame,
		}, { corner(8), pad(0, 0, 8, 0, 8) })
		trackThemeColor(OptionBtn, "BackgroundColor3", "Panel")
		hoverThemeTint(OptionBtn, "Panel", "Sidebar")

		table.insert(self.Window._connections, OptionBtn.MouseButton1Click:Connect(function()
			Dropdown:Set(optionValue)
			ListFrame.Visible = false
		end))
	end

	table.insert(self.Window._connections, ClickOverlay.MouseButton1Click:Connect(function()
		ListFrame.Visible = not ListFrame.Visible
	end))

	registerFlag(config.Flag, Dropdown, selected)
	return Dropdown
end

