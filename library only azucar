function UI:CreateTab(config)
	config = config or {}
	local name = config.Text or config.Name or ("Tab " .. (#self._tabs + 1))
	local isFirst = #self._tabs == 0

	if self.EmptyHint then
		self.EmptyHint:Destroy()
		self.EmptyHint = nil
	end

	local originX = self._originX or 0

	local TabBtn = new("TextButton", {
		Name = name,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = isFirst and Theme.PanelAlt or Theme.Panel,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 34),
		Parent = self.RailList,
	}, { corner(4), stroke(Theme.Border, 1) })

	local TabMark = new("Frame", {
		Name = "Mark",
		Size = UDim2.new(0, 3, 0, 18),
		Position = UDim2.new(0, 0, 0.5, -9),
		BackgroundColor3 = Theme.Active,
		BackgroundTransparency = isFirst and 0 or 1,
		BorderSizePixel = 0,
		Parent = TabBtn,
	}, { corner(2) })
	glossy(TabMark)
	onAccent(function()
		if TabMark.Parent then
			TabMark.BackgroundColor3 = Theme.Active
		end
	end)

	local icon = config.Icon
	local iconIsImage = false
	local iconImage = icon

	if typeof(icon) == "string" then
		if icon:match("^rbxassetid://") or icon:match("^http") then
			iconIsImage = true
		elseif icon:match("^%d+$") then
			iconIsImage = true
			iconImage = "rbxassetid://" .. icon
		end
	elseif typeof(icon) == "number" then
		iconIsImage = true
		iconImage = "rbxassetid://" .. tostring(icon)
	end

	local IconBox
	if iconIsImage then
		IconBox = new("ImageLabel", {
			Name = "Icon",
			Image = iconImage,
			ScaleType = Enum.ScaleType.Fit,
			BackgroundColor3 = Theme.Rail,
			BorderSizePixel = 0,
			Size = UDim2.new(0, 22, 0, 22),
			Position = UDim2.new(0, 9, 0.5, -11),
			Parent = TabBtn,
		}, { corner(4), pad(3) })
	else
		IconBox = new("TextLabel", {
			Name = "Icon",
			Text = (typeof(icon) == "string" and icon ~= "" and icon)
				or string.upper(string.sub(name, 1, 1)),
			Font = Theme.FontBold,
			TextSize = 12,
			TextColor3 = isFirst and Theme.Active or Theme.TextDim,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ClipsDescendants = true,
			BackgroundColor3 = Theme.Rail,
			BorderSizePixel = 0,
			Size = UDim2.new(0, 22, 0, 22),
			Position = UDim2.new(0, 9, 0.5, -11),
			Parent = TabBtn,
		}, { corner(4) })
	end

	local TabName = new("TextLabel", {
		Name = "TabName",
		Text = name,
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = isFirst and Theme.Text or Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ClipsDescendants = true,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 38, 0, 0),
		Size = UDim2.new(1, -44, 1, 0),
		Parent = TabBtn,
	})

	local Panel = new("Frame", {
		Name = name .. "Panel",
		Size = UDim2.new(0, self.PANEL_W, 1, -(self.TOP_Y + self.HEADER_H + self.BOTTOM_MARGIN)),
		Position = UDim2.new(0, originX + self.RAIL_W, 0, self.TOP_Y + self.HEADER_H),
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = isFirst,
		Parent = self.Root,
	}, { corner(6), stroke(Theme.Border, 1) })
	local PanelHome = Panel.Position

	local PanelTitle = new("TextLabel", {
		Name = "PanelTitle",
		Text = string.upper(name),
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundColor3 = Theme.PanelAlt,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 26),
		Parent = Panel,
	}, { pad(0, 0, 10, 0, 10) })

	local List = new("ScrollingFrame", {
		Name = "List",
		Size = UDim2.new(1, 0, 1, -26),
		Position = UDim2.new(0, 0, 0, 26),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Panel,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(0, 4, 0, 8, 0),
	})

	local Tab = setmetatable({
		Window       = self,
		Button       = TabBtn,
		Mark         = TabMark,
		IconBox      = IconBox,
		NameLabel    = TabName,
		IconIsImage  = iconIsImage,
		Panel        = Panel,
		PanelHome    = PanelHome,
		PanelTitle   = PanelTitle,
		List         = List,
		Name         = name,
		_rowCount    = 0,
		_groupPanels = {},
	}, UI)

	onAccent(function()
		if TabBtn.Parent and Panel.Visible then
			TabMark.BackgroundColor3 = Theme.Active
			if not iconIsImage then
				IconBox.TextColor3 = Theme.Active
			end
		end
	end)

	TabBtn.MouseEnter:Connect(function()
		if not Panel.Visible then
			tween(TabBtn, { BackgroundColor3 = Theme.PanelAlt })
			TabName.TextColor3 = Theme.Text
		end
	end)
	TabBtn.MouseLeave:Connect(function()
		if not Panel.Visible then
			tween(TabBtn, { BackgroundColor3 = Theme.Panel })
			TabName.TextColor3 = Theme.TextDim
		end
	end)

	table.insert(self._connections, TabBtn.MouseButton1Click:Connect(function()
		self:SelectTab(name)
	end))

	table.insert(self._tabs, Tab)
	return Tab
end

function UI:SelectTab(name)
	for _, tab in ipairs(self._tabs or {}) do
		local selected = (tab.Name == name)

		tab.Panel.Visible = selected
		tab.Button.BackgroundColor3 = selected and Theme.PanelAlt or Theme.Panel

		if tab.Mark then
			tab.Mark.BackgroundTransparency = selected and 0 or 1
			tab.Mark.BackgroundColor3 = Theme.Active
		end
		if tab.NameLabel then
			tab.NameLabel.TextColor3 = selected and Theme.Text or Theme.TextDim
		end
		if tab.IconBox and not tab.IconIsImage then
			tab.IconBox.TextColor3 = selected and Theme.Active or Theme.TextDim
		end

		if not selected then
			for _, group in pairs(tab._groupPanels) do
				group.Instance.Visible = false
				group.Arrow.Text = ">"
				group.Arrow.TextColor3 = Theme.TextDim
			end
		end
	end
end

