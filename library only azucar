-- ============================================================
-- 	HELPERS DE CONSTRUCCIÓN
-- ============================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do
		inst[prop] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function corner(radius)
	local r = Theme.CornerRadius or 0
	if r <= 0 then
		return new("UICorner", { CornerRadius = UDim.new(0, 0) })
	end
	return new("UICorner", { CornerRadius = UDim.new(0, radius or r) })
end

local function stroke(color, thickness)
	return new("UIStroke", { Color = color or Theme.Border, Thickness = thickness or 1 })
end

local function pad(all, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop    = UDim.new(0, top or all or 0),
		PaddingRight  = UDim.new(0, right or all or 0),
		PaddingBottom = UDim.new(0, bottom or all or 0),
		PaddingLeft   = UDim.new(0, left or all or 0),
	})
end

local function tween(inst, props, time)
	TweenService:Create(inst, TweenInfo.new(time or 0.12), props):Play()
	return inst
end

local function hoverRow(obj)
	obj.MouseEnter:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.PanelAlt })
	end)
	obj.MouseLeave:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.Row })
	end)
end

local function hoverAccent(obj)
	obj.MouseEnter:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.ActiveDim })
	end)
	obj.MouseLeave:Connect(function()
		tween(obj, { BackgroundColor3 = Theme.Active })
	end)
end

-- Capa de "brillo" tipo vidrio/reflejo para poner ENCIMA de una barra de
-- color sólido (la rayita de acento, la marca de pestaña, el cuadrado
-- del Toggle, el relleno del Slider...). Es un degradado blanco que va
-- de semi-opaco arriba a transparente abajo, simulando que la superficie
-- refleja luz en vez de ser un color plano. Active = false para que
-- nunca bloquee clicks del elemento de abajo, y copia el UICorner del
-- padre si tiene uno, para que el brillo respete las esquinas.
local function glossy(inst, rotation)
	if not inst then return nil end

	local shine = new("Frame", {
		Name = "Shine",
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = (inst.ZIndex or 1) + 1,
		Parent = inst,
	}, {
		new("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 255, 255)),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0.00, 0.45),
				NumberSequenceKeypoint.new(0.45, 0.82),
				NumberSequenceKeypoint.new(1.00, 1.00),
			}),
			Rotation = rotation or 90,
		}),
	})
	shine.Active = false

	local parentCorner = inst:FindFirstChildOfClass("UICorner")
	if parentCorner then
		new("UICorner", { CornerRadius = parentCorner.CornerRadius }).Parent = shine
	end

	return shine
end

function UI:SetAccentColor(paletteName)
	local palette = Palettes[paletteName]
	if not palette then
		warn("[AzucarHackerUI] Paleta desconocida: " .. tostring(paletteName))
		return
	end
	UI.CurrentPalette = paletteName
	Theme.Active    = palette.Active
	Theme.ActiveDim = palette.ActiveDim
	for _, listener in ipairs(accentListeners) do
		pcall(listener)
	end
end

-- ============================================================
-- 	NÚCLEO: CALLBACKS EN HILOS INDEPENDIENTES (SIN LÍMITE)
-- ============================================================
local function safeCall(controller, fn, ...)
	fn = fn or function() end
	if typeof(fn) ~= "function" then
		return nil
	end

	local args = table.pack(...)

	if controller then
		controller._threads = controller._threads or {}
	end

	return task.spawn(function()
		local thisThread = coroutine.running()
		if controller then
			controller._threads[thisThread] = true
		end

		local ok, err = pcall(function()
			fn(table.unpack(args, 1, args.n))
		end)
		if not ok then
			warn("[AzucarHackerUI] Error en tu callback: " .. tostring(err))
		end

		if controller and controller._threads then
			controller._threads[thisThread] = nil
		end
	end)
end

local function stopAllThreads(controller)
	if not controller._threads then
		return
	end
	for th in pairs(controller._threads) do
		pcall(task.cancel, th)
	end
	controller._threads = {}
end

local function resolveCallback(config)
	if typeof(config.Callback) == "function" then
		return config.Callback
	end

	local logic = config.Logic
	if logic == nil then
		return function() end
	end
	if typeof(logic) == "function" then
		return logic
	end
	if typeof(logic) == "table" then
		return function(value)
			if typeof(value) == "boolean" then
				if value and typeof(logic.Enable) == "function" then
					logic.Enable()
					return
				end
				if not value and typeof(logic.Disable) == "function" then
					logic.Disable()
					return
				end
			end
			if typeof(logic.Toggle) == "function" then
				logic.Toggle(value)
			elseif typeof(logic.Set) == "function" then
				logic.Set(value)
			elseif typeof(logic.Run) == "function" then
				logic.Run(value)
			else
				warn("[AzucarHackerUI] La tabla pasada en Logic no tiene :Toggle/:Enable+Disable/:Set/:Run.")
			end
		end
	end
	return function() end
end

local function registerFlag(flagName, controller, initialValue)
	if not flagName then
		return
	end
	UI.Flags[flagName] = controller
	UI.FlagValues[flagName] = initialValue
end

local function setFlagValue(flagName, value)
	if flagName == nil then
		return
	end
	UI.FlagValues[flagName] = value
end

local function host(self)
	if self.List then
		return self.List, (self.Window or self), self
	end
	if self._tabs and self._tabs[1] then
		local firstTab = self._tabs[1]
		warn("[AzucarHackerUI] Creaste un control sobre la ventana en vez de sobre una pestaña. "
			.. "Se agregó a la primera pestaña para que no se pierda.")
		return firstTab.List, self, firstTab
	end
	return nil, (self.Window or self), self
end

local function nextOrder(owner)
	owner._rowCount = (owner._rowCount or 0) + 1
	return owner._rowCount
end

local function baseRow(self, height)
	local list, window, owner = host(self)
	if not list then
		return nil, window, owner
	end

	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, height or 30),
		BackgroundColor3 = Theme.Row,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(owner),
		Parent = list,
	}, { pad(0, 0, 10, 0, 10) })

	return row, window, owner
end

local function rowLabel(row, text, rightGap)
	return new("TextLabel", {
		Text = tostring(text),
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -(rightGap or 0), 1, 0),
		Parent = row,
	})
end

local function clickLayer(row)
	return new("TextButton", {
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Parent = row,
	})
end

-- ============================================================
-- 	ANIMACIÓN DE APERTURA: deslizar desde la izquierda
-- ============================================================
-- Corre "inst" desde una posición corrida hacia la izquierda (fuera de
-- pantalla) hasta su "homePos" (la posición normal, guardada una sola
-- vez al crearse). Se usa en Window:Show() para la cabecera, el riel, y
-- la(s) columna(s) que estén visibles en ese momento.
local function slideInFromLeft(inst, homePos, distance, delay)
	if not inst or not homePos then return end
	local startPos = UDim2.new(homePos.X.Scale, homePos.X.Offset - distance, homePos.Y.Scale, homePos.Y.Offset)
	inst.Position = startPos
	task.delay(delay or 0, function()
		if inst.Parent then
			TweenService:Create(inst, TweenInfo.new(0.32, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
				Position = homePos,
			}):Play()
		end
	end)
end

-- ============================================================
-- 	CREATE WINDOW
-- ============================================================
function UI:CreateWindow(config)
	config = config or {}

	local title    = config.Title or config.Name or "Azúcar Hub"
	local subtitle = config.Subtitle or config.SubTitle or ""
	local RAIL_W   = config.RailWidth or 148
	local PANEL_W  = config.PanelWidth or 275
	local HEADER_H = 32
	-- Antes: 0, respetando el todo el inset de Roblox (quedaba pegado
	-- justo debajo de la barra superior — lo más alto posible sin
	-- ignorar esa reserva). Ahora, con IgnoreGuiInset = true más abajo,
	-- este valor se mide desde el borde REAL de la pantalla, así que un
	-- número chico (20 por defecto) deja el panel notablemente más alto
	-- que antes sin pegarlo del todo al borde. Subilo si en tu juego
	-- llega a chocar con los íconos propios de Roblox.
	local TOP_Y    = config.TopOffset or 20
	local BOTTOM_MARGIN = config.BottomMargin or 2

	local ScreenGui = new("ScreenGui", {
		Name = "AzucarHackerUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 999,
		-- true: reclama el espacio que Roblox reserva para su propia
		-- barra superior, para que el panel pueda estirarse un poco más
		-- hacia arriba (ver TOP_Y arriba). Antes era false a propósito
		-- para no quedar tapado; ahora que arranca más abajo del borde
		-- real (TOP_Y = 20, no 0 pegado al inset), no debería chocar con
		-- los íconos de Roblox en el uso normal.
		IgnoreGuiInset = true,
	})

	local protectGui = rawget(_G, "protectgui") or rawget(_G, "protect_gui")
	if typeof(protectGui) == "function" then
		pcall(protectGui, ScreenGui)
	end
	ScreenGui.Parent = getGuiParent()

	local Root = new("Frame", {
		Name = "Root",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
	})

	-- ---------------- Cabecera con el NOMBRE ----------------
	local Header = new("Frame", {
		Name = "Header",
		Size = UDim2.new(0, RAIL_W + PANEL_W, 0, HEADER_H),
		Position = UDim2.new(0, 0, 0, TOP_Y),
		BackgroundColor3 = Theme.Header,
		BorderSizePixel = 0,
		Parent = Root,
	}, { corner(6), stroke(Theme.Border, 1) })
	local HeaderHome = Header.Position

	local AccentBar = new("Frame", {
		Name = "AccentBar",
		Size = UDim2.new(0, 3, 0, 18),
		Position = UDim2.new(0, 8, 0.5, -9),
		BackgroundColor3 = Theme.Active,
		BorderSizePixel = 0,
		Parent = Header,
	}, { corner(2) })
	glossy(AccentBar)
	onAccent(function()
		if AccentBar.Parent then
			AccentBar.BackgroundColor3 = Theme.Active
		end
	end)

	local TitleLabel = new("TextLabel", {
		Name = "Title",
		Text = title,
		Font = Theme.FontBold,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 18, 0, 0),
		Size = UDim2.new(1, -112, 1, 0),
		Parent = Header,
	})

	local SubLabel
	if subtitle ~= "" then
		TitleLabel.Size = UDim2.new(0, math.min(#title * 9 + 8, 130), 1, 0)
		SubLabel = new("TextLabel", {
			Text = subtitle,
			Font = Theme.Font,
			TextSize = 11,
			TextColor3 = Theme.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 18 + TitleLabel.Size.X.Offset + 6, 0, 0),
			Size = UDim2.new(1, -(TitleLabel.Size.X.Offset + 134), 1, 0),
			Parent = Header,
		})
	end

	local BrandLabel = new("TextLabel", {
		Name = "Brand",
		Text = "Azucar UI",
		Font = Theme.FontBold,
		TextSize = 12,
		TextColor3 = Theme.Active,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.new(0, 90, 1, 0),
		Parent = Header,
	})
	onAccent(function()
		if BrandLabel.Parent then
			BrandLabel.TextColor3 = Theme.Active
		end
	end)

	-- ---------------- Riel de pestañas ----------------
	local Rail = new("Frame", {
		Name = "Rail",
		Size = UDim2.new(0, RAIL_W, 1, -(TOP_Y + HEADER_H + BOTTOM_MARGIN)),
		Position = UDim2.new(0, 0, 0, TOP_Y + HEADER_H),
		BackgroundColor3 = Theme.Rail,
		BorderSizePixel = 0,
		Parent = Root,
	}, { corner(6), stroke(Theme.Border, 1) })
	local RailHome = Rail.Position

	local RailList = new("ScrollingFrame", {
		Name = "RailList",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.Border,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = Rail,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
		pad(0, 6, 5, 6, 5),
	})

	local EmptyHint = new("TextLabel", {
		Name = "EmptyHint",
		Text = "Sin pestañas.\nRevisá la consola (F9):\nalgo cortó tu script\nantes de crearlas.",
		Font = Theme.Font,
		TextSize = 12,
		TextColor3 = Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		BackgroundColor3 = Theme.Panel,
		BorderSizePixel = 0,
		Size = UDim2.new(0, PANEL_W, 0, 90),
		Position = UDim2.new(0, RAIL_W, 0, TOP_Y + HEADER_H),
		Parent = Root,
	}, { stroke(Theme.Border, 1), pad(10) })

	local NotifyHolder = new("Frame", {
		Name = "Notifications",
		Size = UDim2.new(0, 250, 1, -20),
		Position = UDim2.new(1, -262, 0, 10),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
	}, {
		new("UIListLayout", {
			Padding = UDim.new(0, 6),
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local Window = setmetatable({
		ScreenGui   = ScreenGui,
		Root        = Root,
		Header      = Header,
		HeaderHome  = HeaderHome,
		TitleLabel  = TitleLabel,
		SubLabel    = SubLabel,
		Rail        = Rail,
		RailHome    = RailHome,
		RailList    = RailList,
		EmptyHint   = EmptyHint,
		NotifyHolder = NotifyHolder,
		RAIL_W      = RAIL_W,
		PANEL_W     = PANEL_W,
		HEADER_H    = HEADER_H,
		TOP_Y       = TOP_Y,
		BOTTOM_MARGIN = BOTTOM_MARGIN,
		_tabs        = {},
		_connections = {},
		_visible     = true,
	}, UI)

	local function track(conn)
		table.insert(Window._connections, conn)
		return conn
	end

	Header.Active = false

	local toggleKey = config.ToggleKey or Enum.KeyCode.K
	track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == toggleKey then
			Window:Toggle()
		end
	end))

	table.insert(UI.Windows, Window)
	return Window
end

-- ============================================================
-- 	MÉTODOS DE VENTANA
-- ============================================================
function UI:MoveTo(offsetX, offsetY)
	self.TOP_Y = offsetY
	self._originX = offsetX

	self.Header.Position = UDim2.new(0, offsetX, 0, offsetY)
	self.HeaderHome = self.Header.Position
	self.Rail.Position   = UDim2.new(0, offsetX, 0, offsetY + self.HEADER_H)
	self.Rail.Size       = UDim2.new(0, self.RAIL_W, 1, -(offsetY + self.HEADER_H + self.BOTTOM_MARGIN))
	self.RailHome = self.Rail.Position

	if self.EmptyHint then
		self.EmptyHint.Position = UDim2.new(0, offsetX + self.RAIL_W, 0, offsetY + self.HEADER_H)
	end

	for _, tab in ipairs(self._tabs) do
		tab.Panel.Position = UDim2.new(0, offsetX + self.RAIL_W, 0, offsetY + self.HEADER_H)
		tab.Panel.Size     = UDim2.new(0, self.PANEL_W, 1, -(offsetY + self.HEADER_H + self.BOTTOM_MARGIN))
		tab.PanelHome = tab.Panel.Position
		for _, group in pairs(tab._groupPanels) do
			group.Instance.Position = UDim2.new(0, offsetX + self.RAIL_W + self.PANEL_W, 0, offsetY + self.HEADER_H)
			group.Instance.Size     = UDim2.new(0, self.PANEL_W, 1, -(offsetY + self.HEADER_H + self.BOTTOM_MARGIN))
			group.HomePos = group.Instance.Position
		end
	end
