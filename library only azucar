-- Reproduce la entrada deslizante desde la izquierda para la cabecera, el
-- riel, y la columna (o columnas) visibles en este momento. Cada pieza
-- arranca un poquito más tarde que la anterior (un delay chiquito) para
-- que se sienta como una sola tira entrando, no todo de golpe.
function UI:_playOpenAnimation()
	local distance = self.RAIL_W + self.PANEL_W + 80

	slideInFromLeft(self.Header, self.HeaderHome, distance, 0)
	slideInFromLeft(self.Rail, self.RailHome, distance, 0.03)

	for _, tab in ipairs(self._tabs or {}) do
		if tab.Panel.Visible then
			slideInFromLeft(tab.Panel, tab.PanelHome, distance, 0.06)
		end
		for _, group in pairs(tab._groupPanels or {}) do
			if group.Instance.Visible then
				slideInFromLeft(group.Instance, group.HomePos, distance, 0.09)
			end
		end
	end
end

function UI:Show()
	self.Root.Visible = true
	self._visible = true
	self:_playOpenAnimation()
end

function UI:Hide()
	self.Root.Visible = false
	self._visible = false
end

function UI:Toggle()
	if self._visible then
		self:Hide()
	else
		self:Show()
	end
end

