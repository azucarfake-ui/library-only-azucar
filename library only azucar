		Name = "TopBar",
		Size = UDim2.new(1, -MARGIN * 2, 0, TOPBAR_H),
		Position = UDim2.new(0, MARGIN, 0, MARGIN),
		BackgroundColor3 = Theme.Sidebar,
		BackgroundTransparency = Theme.PanelTransparency,
		Parent = Root,
	}, { corner(16), stroke(Theme.Stroke, 1) })
	trackThemeColor(TopBar, "BackgroundColor3", "Sidebar")

	local TopBarLeft = new("Frame", {
		Name = "TopBarLeft",
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 0, 32),
		Position = UDim2.new(0, 20, 0.5, -16),
