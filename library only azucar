		TextTruncate = Enum.TextTruncate.AtEnd,
		BackgroundColor3 = Theme.PanelAlt,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 26),
		Parent = GroupPanel,
	}, { pad(0, 0, 10, 0, 10) })
	onAccent(function()
		if GroupTitle.Parent then
			GroupTitle.TextColor3 = Theme.Active
		end
	end)

	local GroupList = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -26),
		Position = UDim2.new(0, 0, 0, 26),
		BackgroundTransparency = 1,
