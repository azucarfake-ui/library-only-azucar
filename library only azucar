-- Registro GENÉRICO de todo lo que depende del color de acento: cada
-- entrada es una función sin argumentos que sabe repintarse a sí misma
-- leyendo el Theme.Accent/AccentDim ACTUAL en el momento en que se la
-- llama. Esto es lo que garantiza que TODA la interfaz cambie de color de
-- una sola vez y sin fallos: no importa si el elemento es un color sólido,
-- un degradado, o algo que además depende de un estado propio (como el
-- riel de un Toggle prendido/apagado, o qué pestaña está activa ahora
-- mismo) — cada uno se registra con la lógica exacta que necesita.
local accentListeners = {}

local function onAccentChanged(fn)
	table.insert(accentListeners, fn)
	return fn
end

-- Atajo para el caso más común: una propiedad de color sólido (ej.
-- BackgroundColor3 de un botón) que siempre debe pasar a ser Theme.Accent.
-- Versión genérica: engancha CUALQUIER propiedad de color de CUALQUIER
-- instancia a CUALQUIER clave del Theme (no solo Accent). Esto es lo que
-- permite que, además del acento, los FONDOS (Background/Sidebar/Panel/
-- PanelAlt) también se repinten al elegir una paleta.
local function trackThemeColor(inst, prop, themeKey)
	prop = prop or "BackgroundColor3"
	themeKey = themeKey or "Accent"
	onAccentChanged(function()
		if inst and inst.Parent then
			inst[prop] = Theme[themeKey]
		end
	end)
	return inst
end

local function trackAccentColor(inst, prop)
	return trackThemeColor(inst, prop, "Accent")
end

-- ============================================================
-- 	HELPERS
-- ============================================================
local function new(class, props, children)
	local inst = Instance.new(class)
	for prop, value in pairs(props or {}) do
		inst[prop] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	return inst
end

local function corner(radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

local function stroke(color, thickness)
	-- "Dinámico" = no se pasó color, O se pasó explícitamente el
	-- Theme.Stroke actual (que es como está escrito el 99% del código:
	-- stroke(Theme.Stroke, 1)). Solo se queda fijo si de verdad se pasa
	-- un color DISTINTO al de Theme.Stroke (ej. un stroke a medida).
	local wantsDynamic = (color == nil) or (color == Theme.Stroke)
	local s = new("UIStroke", { Color = color or Theme.Stroke, Thickness = thickness or 1 })
	if wantsDynamic then
		onAccentChanged(function()
			if s and s.Parent then
				s.Color = Theme.Stroke
			end
		end)
	end
	return s
end

local function pad(all, top, right, bottom, left)
	return new("UIPadding", {
		PaddingTop    = UDim.new(0, top or all or 0),
		PaddingRight  = UDim.new(0, right or all or 0),
		PaddingBottom = UDim.new(0, bottom or all or 0),
		PaddingLeft   = UDim.new(0, left or all or 0),
	})
end

local function hoverTint(guiObject, baseColor, hoverColor)
	guiObject.MouseEnter:Connect(function()
		TweenService:Create(guiObject, TweenInfo.new(0.12), { BackgroundColor3 = hoverColor }):Play()
	end)
	guiObject.MouseLeave:Connect(function()
		TweenService:Create(guiObject, TweenInfo.new(0.12), { BackgroundColor3 = baseColor }):Play()
	end)
end

-- FIX color de acento "que se queda pegado": hoverTint normal recibe
-- baseColor/hoverColor como valores FIJOS, capturados en el instante en
-- que se llama. Para botones cuyo color depende del acento (Minimizar,
-- Cerrar, la Burbuja, los Botones normales) eso es un bug: al cambiar de
-- paleta con SugarUI:SetAccentColor, trackAccentColor los repinta bien
-- por un instante, pero el primer MouseEnter/MouseLeave los vuelve a
-- pintar con el rojo (u otro color) que tenían guardado desde que se
-- crearon, no con el actual. hoverAccentTint lee Theme.Accent/AccentDim
-- DENTRO del propio evento, en el momento exacto en que se dispara, así
-- siempre usa el color de acento que esté activo en ese momento.
local function hoverAccentTint(guiObject)
	guiObject.MouseEnter:Connect(function()
		TweenService:Create(guiObject, TweenInfo.new(0.12), { BackgroundColor3 = Theme.AccentDim }):Play()
	end)
	guiObject.MouseLeave:Connect(function()
		TweenService:Create(guiObject, TweenInfo.new(0.12), { BackgroundColor3 = Theme.Accent }):Play()
	end)
end

-- Igual que hoverAccentTint pero para pares de colores de FONDO (Panel/
-- PanelAlt, Sidebar/PanelAlt, etc.) que ahora también cambian de paleta.
-- Lee Theme[baseKey]/Theme[hoverKey] en el momento del hover, nunca un
-- valor viejo capturado desde que se creó el elemento.
local function hoverThemeTint(guiObject, baseKey, hoverKey)
	guiObject.MouseEnter:Connect(function()
		TweenService:Create(guiObject, TweenInfo.new(0.12), { BackgroundColor3 = Theme[hoverKey] }):Play()
	end)
	guiObject.MouseLeave:Connect(function()
		TweenService:Create(guiObject, TweenInfo.new(0.12), { BackgroundColor3 = Theme[baseKey] }):Play()
	end)
end

local function pressFeedback(guiObject)
	local originalSize = guiObject.Size
	local pressedSize = originalSize - UDim2.new(0, 4, 0, 2)
	local isPressed = false

	guiObject.MouseButton1Down:Connect(function()
		isPressed = true
		TweenService:Create(guiObject, TweenInfo.new(0.06), { Size = pressedSize }):Play()
	end)

	local function restore()
		if not isPressed then return end
		isPressed = false
		TweenService:Create(guiObject, TweenInfo.new(0.08), { Size = originalSize }):Play()
	end
	guiObject.MouseButton1Up:Connect(restore)
	guiObject.MouseLeave:Connect(restore)
end

-- accentGradient() queda igual para quien ya la use, pero ahora se
-- registra a través de onAccentChanged para poder recolorearse al cambiar
-- de paleta (ver SugarUI:SetAccentColor más abajo).
local function accentGradient(rotation)
	local g = new("UIGradient", { Color = ColorSequence.new(Theme.Accent, Theme.AccentDim), Rotation = rotation or 90 })
	onAccentChanged(function()
		if g and g.Parent then
			g.Color = ColorSequence.new(Theme.Accent, Theme.AccentDim)
		end
	end)
	return g
end

-- Cambia el color de acento de TODA la interfaz YA CONSTRUIDA (topbar,
-- burbuja, botones, sliders, dropdowns, estadísticas, la pestaña que esté
-- activa en este momento, los toggles que estén encendidos, el ícono de
-- perfil, la piruleta de la burbuja...) en un solo paso, y de cualquier
-- cosa que se cree después (los nuevos elementos leen
-- Theme.Accent/AccentDim al momento de crearse). paletteName: "Azul" |
-- "Rojo" | "Negro".
--
-- Recorre accentListeners con un pcall POR ENTRADA: si un elemento puntual
-- ya fue destruido o falla al repintarse, el resto de la interfaz se sigue
-- repintando igual — un elemento roto nunca deja el resto del panel a
-- medio pintar ni corta el cambio de color a la mitad.
function SugarUI:SetAccentColor(paletteName)
	local palette = ThemePalettes[paletteName]
	if not palette then
		warn("[SugarUI] Paleta de color desconocida: " .. tostring(paletteName))
		return
	end

	SugarUI.CurrentPalette = paletteName
	Theme.Accent     = palette.Accent
	Theme.AccentDim  = palette.AccentDim
	Theme.Background = palette.Background
	Theme.Sidebar    = palette.Sidebar
	Theme.Panel      = palette.Panel
	Theme.PanelAlt   = palette.PanelAlt
	Theme.Stroke     = palette.Stroke

	for _, listener in ipairs(accentListeners) do
		pcall(listener)
	end
end

-- ============================================================
-- 	NÚCLEO: INVOCACIÓN ASÍNCRONA SEGURA (CONCURRENCIA ILIMITADA)
-- ============================================================
local function safeCall(controller, fn, ...)
	fn = fn or function() end
	if typeof(fn) ~= "function" then
		return nil
	end

	local args = table.pack(...)

	if controller then
		controller._threads = controller._threads or {}
	end

	local thread = task.spawn(function()
		local self = coroutine.running()
		if controller then
			controller._threads[self] = true
		end

		local ok, err = pcall(function()
			fn(table.unpack(args, 1, args.n))
		end)
		if not ok then
			warn("[SugarUI] Error en callback conectado por el usuario: " .. tostring(err))
		end

		if controller and controller._threads then
			controller._threads[self] = nil
		end
	end)

	return thread
end

local function stopThread(controller)
	if not controller._threads then return end
	for thread in pairs(controller._threads) do
		pcall(task.cancel, thread)
	end
	table.clear(controller._threads)
end

-- ============================================================
-- 	ADAPTADOR DE LÓGICA EXTERNA
-- ============================================================
local function resolveCallback(config)
	if typeof(config.Callback) == "function" then
		return config.Callback
	end

	local logic = config.Logic
	if logic == nil then
		return function() end
	end

	if typeof(logic) == "function" then
		return logic
	end

	if typeof(logic) == "table" then
		return function(value)
			if typeof(value) == "boolean" then
				if value and typeof(logic.Enable) == "function" then
					logic.Enable()
					return
				elseif not value and typeof(logic.Disable) == "function" then
					logic.Disable()
					return
				end
			end
			if typeof(logic.Toggle) == "function" then
				logic.Toggle(value)
			elseif typeof(logic.Set) == "function" then
				logic.Set(value)
			elseif typeof(logic.Run) == "function" then
				logic.Run(value)
			else
				warn("[SugarUI] Logic conectada no tiene :Toggle/:Enable+Disable/:Set/:Run — revisá el nombre del método.")
			end
		end
	end

	return function() end
end

-- Animación de apertura tipo "encender la tele": la ventana arranca
-- como una línea fina horizontal, centrada verticalmente donde va a
-- terminar, y se estira hacia arriba y abajo hasta su tamaño real.
local function playOpenAnimation(root, targetSize, targetPosition)
	root.Size = UDim2.new(targetSize.X.Scale, targetSize.X.Offset, 0, 2)
	root.Position = UDim2.new(
		targetPosition.X.Scale, targetPosition.X.Offset,
		targetPosition.Y.Scale, targetPosition.Y.Offset + targetSize.Y.Offset / 2
	)
	TweenService:Create(root, TweenInfo.new(1.0, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = targetSize,
		Position = targetPosition,
	}):Play()
end

local function registerFlag(flagName, controller, initialValue)
	if not flagName then return end
	SugarUI.Flags[flagName] = controller
	SugarUI.FlagValues[flagName] = initialValue
end

